  "_bodies": {
    "claude/fixture-seam-0001": {
      "source": "claude",
      "id": "fixture-seam-0001",
      "title": "How the panel reads the thread archive",
      "url": "https://example.invalid/threads/fixture-seam-0001",
      "started_at": "2026-08-20T14:00:00Z",
      "partial": false,
      "turns": [
        {
          "id": "turn-000",
          "role": "user",
          "at": "1787000000",
          "text": "We need to decide how the panel reads the thread archive."
        },
        {
          "id": "turn-001",
          "role": "assistant",
          "at": "1787000090",
          "text": "The obvious move is to import the harness package directly."
        },
        {
          "id": "turn-002",
          "role": "assistant",
          "at": "1787000180",
          "text": ""
        },
        {
          "id": "turn-003",
          "role": "user",
          "at": "1787000270",
          "text": "That couples them. If the storage layout changes, the panel breaks."
        },
        {
          "id": "turn-004",
          "role": "assistant",
          "at": "1787000360",
          "text": "However, HTTP over loopback means we need the harness running."
        },
        {
          "id": "turn-005",
          "role": "assistant",
          "at": "1787000450",
          "text": ""
        },
        {
          "id": "turn-006",
          "role": "user",
          "at": "1787000540",
          "text": "That is a precondition we can declare, though. Side note - what port?"
        },
        {
          "id": "turn-007",
          "role": "assistant",
          "at": "1787000630",
          "text": "3141. The harness publishes it, and the host stays loopback."
        },
        {
          "id": "turn-008",
          "role": "user",
          "at": "1787000720",
          "text": "Back to the seam - so it is HTTP plus a schema, and nothing imports anything."
        },
        {
          "id": "turn-009",
          "role": "assistant",
          "at": "1787000810",
          "text": ""
        },
        {
          "id": "turn-010",
          "role": "assistant",
          "at": "1787000900",
          "text": "Right. The schema is the contract and the port is the only setting."
        },
        {
          "id": "turn-011",
          "role": "user",
          "at": "1787000990",
          "text": "What happens when the harness is not running at all?"
        },
        {
          "id": "turn-012",
          "role": "assistant",
          "at": "1787001080",
          "text": "The panel says nobody answered, and names the command that fixes it."
        },
        {
          "id": "turn-013",
          "role": "user",
          "at": "1787001170",
          "text": "Not an empty table. An empty table and a broken one look identical."
        },
        {
          "id": "turn-014",
          "role": "assistant",
          "at": "1787001260",
          "text": "Agreed. Reachable is a field, and every caller reads it first."
        },
        {
          "id": "turn-015",
          "role": "user",
          "at": "1787001350",
          "text": "Then the decision is the seam. Let us write that down."
        }
      ]
    },
    "chatgpt/fixture-ports-0002": {
      "source": "chatgpt",
      "id": "fixture-ports-0002",
      "title": "Choosing service ports nobody has to look up",
      "url": "https://example.invalid/threads/fixture-ports-0002",
      "started_at": "2026-08-19T09:30:00Z",
      "partial": false,
      "turns": [
        {
          "id": "turn-000",
          "role": "user",
          "at": "1787000000",
          "text": "Three services need three ports somebody can recall."
        },
        {
          "id": "turn-001",
          "role": "assistant",
          "at": "1787000090",
          "text": "Pi for the harness, phi for the panel, e for the code maps."
        },
        {
          "id": "turn-002",
          "role": "user",
          "at": "1787000180",
          "text": "The joke port everyone reaches for was already in use here."
        },
        {
          "id": "turn-003",
          "role": "assistant",
          "at": "1787000270",
          "text": "Which is the argument against the port everybody thinks of first."
        }
      ]
    }
  },
